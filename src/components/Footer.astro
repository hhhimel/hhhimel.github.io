---
interface Props {
  siteName: string;
}
const { siteName } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="margin-rule pl-6 sm:pl-8 py-8 mt-4 font-mono text-xs text-ink-soft dark:text-paper/60 flex flex-wrap justify-between gap-2">
  <span>&copy; {year} {siteName}</span>
  <span>built with Astro — logged daily</span>
</footer>
