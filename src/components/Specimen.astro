---
interface Props {
  title: string;
  summary: string;
  stack: string[];
  liveUrl?: string;
  codeUrl?: string;
}
const { title, summary, stack, liveUrl, codeUrl } = Astro.props;
---

<article class="py-6 border-b border-rule/60 dark:border-white/10 last:border-none">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h2 class="font-display text-xl font-semibold">{title}</h2>
    <div class="font-mono text-xs flex gap-3">
      {liveUrl && <a href={liveUrl} class="text-moss-dark dark:text-[#A9C285] hover:text-rust transition-colors">live</a>}
      {codeUrl && <a href={codeUrl} class="text-moss-dark dark:text-[#A9C285] hover:text-rust transition-colors">source</a>}
    </div>
  </div>
  <p class="mt-1.5 text-ink-soft dark:text-paper/70 max-w-prose">{summary}</p>
  <ul class="mt-2 flex flex-wrap gap-2 font-mono text-xs text-ink-soft dark:text-paper/50">
    {stack.map((item) => <li>{item}</li>)}
  </ul>
</article>
