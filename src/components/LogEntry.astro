---
interface Props {
  href: string;
  date: Date;
  title: string;
  summary: string;
  tags: string[];
}
const { href, date, title, summary, tags } = Astro.props;
const dateLabel = date.toISOString().slice(0, 10).replaceAll('-', '.');
---

<article class="py-6 border-b border-rule/60 dark:border-white/10 last:border-none">
  <a href={href} class="group block">
    <div class="flex items-baseline gap-3 font-mono text-xs text-rust">
      <time datetime={date.toISOString()}>{dateLabel}</time>
      {tags.map((tag) => <span class="text-ink-soft dark:text-paper/50">#{tag}</span>)}
    </div>
    <h2 class="mt-1.5 font-display text-xl font-semibold group-hover:text-moss-dark dark:group-hover:text-[#A9C285] transition-colors">
      {title}
    </h2>
    <p class="mt-1 text-ink-soft dark:text-paper/70 max-w-prose">{summary}</p>
  </a>
</article>
