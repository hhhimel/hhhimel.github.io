---
import BaseLayout from '../layouts/BaseLayout.astro';
import LogEntry from '../components/LogEntry.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Himel">
  <section class="pt-2 pb-8">
    <p class="font-display text-lg leading-relaxed max-w-prose">
      I study genetic variability in blackgram at Sher-e-Bangla Agricultural
      University, and build software on the side — this is where I log both:
      field findings, thesis notes, and whatever I've been building.
    </p>
  </section>

  <section>
    <h2 class="font-mono text-xs text-ink-soft dark:text-paper/60 tracking-wide">FIELD LOG</h2>
    <div class="mt-1">
      {posts.length === 0 ? (
        <p class="py-8 text-ink-soft dark:text-paper/60">No entries yet — the first one is coming.</p>
      ) : (
        posts.map((post) => (
          <LogEntry
            href={`${base}blog/${post.id}`}
            date={post.data.date}
            title={post.data.title}
            summary={post.data.summary}
            tags={post.data.tags}
          />
        ))
      )}
    </div>
  </section>
</BaseLayout>
