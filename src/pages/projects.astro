---
import BaseLayout from '../layouts/BaseLayout.astro';
import Specimen from '../components/Specimen.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Specimens" description="Things I've built.">
  <section class="pt-2">
    <h1 class="font-display text-2xl font-semibold">Specimens</h1>
    <p class="mt-2 text-ink-soft dark:text-paper/70 max-w-prose">
      Projects I've built and shipped — web platforms, mostly, plus the
      occasional hardware detour.
    </p>
    <div class="mt-6">
      {projects.map((project) => (
        <Specimen
          title={project.data.title}
          summary={project.data.summary}
          stack={project.data.stack}
          liveUrl={project.data.liveUrl}
          codeUrl={project.data.codeUrl}
        />
      ))}
    </div>
  </section>
</BaseLayout>
