---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Not found">
  <section class="pt-10">
    <p class="font-mono text-xs text-rust">404</p>
    <h1 class="mt-2 font-display text-2xl font-semibold">Nothing logged here.</h1>
    <p class="mt-2 text-ink-soft dark:text-paper/70">
      This entry doesn't exist. <a href={base} class="underline">Back to the log</a>.
    </p>
  </section>
</BaseLayout>
